# Template de variáveis de ambiente do Preço Suplemento.
# Copie este arquivo para .env.local e preencha os valores.
# .env.local NÃO vai pro git (está no .gitignore).

# --- Supabase ---
# Painel: https://supabase.com/dashboard → projeto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role key — APENAS server-side (jobs de ingestão, route handlers).
# NUNCA exponha no cliente. Bypassa RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mercado Livre ---
# Tag de afiliado (do painel https://www.mercadolivre.com.br/l/afiliados-portal-do-afiliado)
ML_AFFILIATE_TAG=

# OAuth do DevCenter — OBRIGATÓRIO desde mai/2026 (ML fechou acesso anônimo)
# https://developers.mercadolivre.com.br/devcenter
ML_APP_ID=
ML_CLIENT_SECRET=
ML_ADMIN_SECRET=
ML_ALLOWED_USER_ID=
# Gere exatamente 32 bytes em base64: openssl rand -base64 32
ML_TOKEN_ENCRYPTION_KEY=
ML_TOKEN_ENCRYPTION_KEY_VERSION=1
# URL exata cadastrada como "Redirect URI" no painel do app.
# Executor de produção: https://compara-suple-sable.vercel.app/api/auth/ml/callback
ML_REDIRECT_URI=

# --- Cron ---
# Configure somente no projeto Vercel do Gabriel, executor único da ingestão.
# Secret para autorizar GET/POST em /api/cron/ml-ingest.
# Gere com: openssl rand -hex 32
CRON_SECRET=

# --- Readiness ---
# Após este prazo, a interface avisa que os preços podem estar defasados.
READINESS_DEGRADED_AFTER_HOURS=30
# Após este prazo, readiness informa indisponibilidade para monitoramento.
READINESS_UNAVAILABLE_AFTER_HOURS=72
# Tempo máximo da consulta de readiness ao banco.
READINESS_TIMEOUT_MS=2000
